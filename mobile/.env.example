# Copy to .env and fill in. EXPO_PUBLIC_* values are inlined into the app/web bundle at build
# time, so anyone with the app can extract the key: use a restricted, budget-capped key.
# For EAS cloud builds, set the same names with `npx eas-cli@latest env:set` (see README).
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-3-flash-preview
